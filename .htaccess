# ============================================================
# CESCHGROUP — configuración de Apache para cPanel
#
# El sitio es estático: no hay router ni framework. Esto solo
# comprime, cachea, fuerza HTTPS y pone cabeceras de seguridad.
# ============================================================

# ---- HTTPS y dominio canónico -------------------------------
# Descomentar cuando el certificado SSL esté emitido en cPanel.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
#
#   # Un solo host canónico: sin www redirige a www, o al revés.
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#   RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
# </IfModule>

# ---- Compresión ---------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Caché ---------------------------------------------------
# Las imágenes y GSAP no cambian: caché larga. El HTML y los datos
# sí cambian en cada despliegue, así que se revalidan siempre.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # datos.js define el contenido del sitio: nunca se sirve cacheado
  # o una obra nueva tarda una semana en aparecer.
  <FilesMatch "datos\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ---- Cabeceras de seguridad -------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always unset X-Powered-By
</IfModule>

# ---- Tipos MIME ---------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# ---- Archivos que nunca deben servirse ----------------------
# El repositorio se clona completo en el host; estas carpetas son
# de trabajo, no del sitio público.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(openspec|\.git)/ - [F,L]
</IfModule>

<FilesMatch "^(LEEME\.md|\.gitignore|files\.zip)$">
  Require all denied
</FilesMatch>

# ---- Páginas de error ----------------------------------------
ErrorDocument 404 /index.html

Options -Indexes
